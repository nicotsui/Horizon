      { "name": "OilPrice", "url": "https://oilprice.com/rss/main", "enabled": true, "category": "commodities", "profile": "global-market", "content_extractor": "trafilatura" },
      { "name": "少数派", "url": "https://sspai.com/feed", "enabled": true, "category": "tools", "profile": "tools-windows" },
      { "name": "小众软件", "url": "https://www.appinn.com/feed/", "enabled": true, "category": "tools", "profile": "tools-windows" },
