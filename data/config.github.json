{
  "ai": {
    "provider": "openai",
    "model": "glm-4-flash",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "api_key_env": "ZHIPU_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 3,
    "languages": ["zh", "en"],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "it-opensource",
    "profile_settings": {
      "cn-macro": { "threshold": 7.0, "topic_dedup": true },
      "global-market": { "threshold": 7.0, "topic_dedup": true },
      "ai-frontier": { "threshold": 7.0, "topic_dedup": true },
      "it-opensource": { "threshold": 6.0, "topic_dedup": true },
      "tools-windows": { "threshold": 4.0, "topic_dedup": false }
    }
  },
  "sources": {
    "github": [
      { "type": "user_events", "username": "karpathy", "enabled": true, "profile": "ai-frontier" },
      { "type": "repo_releases", "owner": "astral-sh", "repo": "uv", "enabled": true, "profile": "it-opensource" },
      { "type": "repo_releases", "owner": "vllm-project", "repo": "vllm", "enabled": true, "profile": "ai-frontier" },
      { "type": "repo_releases", "owner": "sgl-project", "repo": "sglang", "enabled": true, "profile": "ai-frontier" },
      { "type": "repo_releases", "owner": "triton-lang", "repo": "triton", "enabled": true, "profile": "ai-frontier" },
      { "type": "repo_releases", "owner": "akfamily", "repo": "akshare", "enabled": true, "profile": "cn-macro" },
      { "type": "repo_releases", "owner": "vnpy", "repo": "vnpy", "enabled": true, "profile": "cn-macro" },
      { "type": "repo_releases", "owner": "mpquant", "repo": "MyTT", "enabled": true, "profile": "cn-macro" },
      { "type": "repo_releases", "owner": "ollama", "repo": "ollama", "enabled": true, "profile": "it-opensource" },
      { "type": "repo_releases", "owner": "langchain-ai", "repo": "langchain", "enabled": true, "profile": "ai-frontier" }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "ai-frontier"
    },
    "rss": [
